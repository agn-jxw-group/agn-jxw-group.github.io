---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArrowLink from '../../../components/ArrowLink.astro';
import { researchStoryPath, withBase } from '../../../config/site';

export async function getStaticPaths() {
  return (await getCollection('researchCategories')).map((category) => ({
    params: { pillar: category.id },
    props: { category },
  }));
}

const { category } = Astro.props;
const stories = (await getCollection('research', ({ data }) => !data.draft && data.pillar === category.id))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title={category.data.heading} description={category.data.introduction} image={category.data.heroImage} darkHeader>
  <section class="pillar-hero">
    <img class="pillar-hero-image" src={withBase(category.data.heroImage)} alt={category.data.heroAlt} width="2400" height="1000" />
    <div class="pillar-hero-shade"></div>
    <div class="pillar-hero-copy"><p class="eyebrow">Research · {category.data.shortHeading}</p><h1>{category.data.heading}</h1><p class="lede">{category.data.introduction}</p></div>
    <p class="pillar-hero-credit"><a href={category.data.heroSourceUrl} target="_blank" rel="noreferrer">{category.data.heroCredit}<span class="sr-only"> (opens in a new tab)</span></a></p>
  </section>
  <section class="section"><div class="section-inner">
    <header class="pillar-intro"><p class="eyebrow">Figure-led stories</p><h2>Featured articles</h2><p>{category.data.question}</p></header>
    <div class="pillar-stories">
      {stories.map((story) => <article class="story-row">
        <a class="story-row-image" href={withBase(researchStoryPath(story.data.pillar, story.id))} aria-label={`Read ${story.data.title}`}>
          <img src={withBase(story.data.cardFigure ?? story.data.figure.replace(/\.webp$/, '-card.webp'))} alt={story.data.cardFigureAlt ?? story.data.figureAlt} loading="lazy" width="700" height="438" />
        </a>
        <div><p class="eyebrow">{story.data.journal}</p><h3>{story.data.title}</h3><p>{story.data.summary}</p><ArrowLink href={researchStoryPath(story.data.pillar, story.id)} label="Learn more" /></div>
      </article>)}
    </div>
    {category.data.relatedPapers.length > 0 && <aside class="future-tracks"><p class="eyebrow">Coming next</p><h2>More paths through this question</h2><div>{category.data.relatedPapers.map((paper) => <article><span>{paper.year}</span><h3>{paper.title}</h3><p>{paper.authors}{paper.status ? ` · ${paper.status}` : ''}</p>{paper.url && <ArrowLink href={paper.url} label="Open paper" external />}</article>)}</div></aside>}
  </div></section>
</BaseLayout>
<style>
.pillar-hero{position:relative;min-height:clamp(430px,55vw,610px);display:flex;align-items:flex-end;overflow:hidden;background:#000;color:#fff;padding:clamp(7rem,12vw,10rem) var(--pad) clamp(3.5rem,6vw,5rem)}.pillar-hero-image,.pillar-hero-shade{position:absolute;inset:0;width:100%;height:100%}.pillar-hero-image{object-fit:cover}.pillar-hero-shade{background:linear-gradient(90deg,rgba(0,0,0,.9) 0%,rgba(0,0,0,.68) 46%,rgba(0,0,0,.16) 82%),linear-gradient(0deg,rgba(0,0,0,.7),transparent 65%)}.pillar-hero-copy{position:relative;z-index:2;width:100%;max-width:var(--max);margin:0 auto}.pillar-hero h1{max-width:1000px;color:#fff;margin:0 0 1.25rem}.pillar-hero .lede{max-width:790px;margin:0;color:#eee;font-size:clamp(1rem,1.45vw,1.18rem);line-height:1.58}.pillar-hero .eyebrow{color:#c5c5c7}.pillar-hero-credit{position:absolute;z-index:3;right:var(--pad);bottom:1rem;max-width:min(48rem,70vw);margin:0;text-align:right;font:400 .6rem/1.45 var(--mono);color:#c5c5c7}.pillar-hero-credit a{text-underline-offset:3px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.pillar-intro{display:grid;grid-template-columns:1.2fr .8fr;column-gap:3rem;align-items:end;margin-bottom:2rem}.pillar-intro .eyebrow{grid-column:1/-1}.pillar-intro h2{margin:0}.pillar-intro>p:last-child{margin:0;font-size:1.05rem}.story-row{display:grid;grid-template-columns:minmax(300px,.8fr) minmax(340px,1.2fr);gap:clamp(2rem,5vw,5rem);padding:clamp(2rem,4vw,4rem) 0;border-top:1px solid var(--line);align-items:center}.story-row-image{aspect-ratio:16/9;overflow:hidden;background:#e3e3e3}.story-row-image img{width:100%;height:100%;object-fit:cover}.story-row h3{font-size:clamp(1.7rem,3vw,2.8rem);margin-bottom:1rem}.story-row>div>p:not(.eyebrow){max-width:650px}.future-tracks{border-top:1px solid #000;margin-top:4rem;padding-top:3rem}.future-tracks>h2{font-size:clamp(1.8rem,3vw,2.8rem);margin-bottom:2rem}.future-tracks>div{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}.future-tracks article{border-top:1px solid var(--line);padding-top:1rem}.future-tracks article>span{font:500 .68rem var(--mono);color:var(--red)}.future-tracks h3{font-size:1.25rem;margin:1.2rem 0 .6rem}.future-tracks article p{font-size:.9rem}@media(max-width:760px){.pillar-hero{min-height:560px;padding-bottom:5.5rem}.pillar-hero-shade{background:linear-gradient(0deg,rgba(0,0,0,.94),rgba(0,0,0,.3) 90%)}.pillar-hero-credit{left:var(--pad);right:var(--pad);max-width:none;text-align:left}.pillar-intro,.story-row{grid-template-columns:1fr}.pillar-intro{align-items:start}.story-row{gap:1.5rem}.future-tracks>div{grid-template-columns:1fr}}
</style>
