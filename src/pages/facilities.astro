---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import { withBase } from '../config/site';
const facilities=(await getCollection('facilities')).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout title="Facilities" description="The X-ray and optical observatories behind our view of the active Universe.">
  <section class="page-hero"><div><p class="eyebrow">Facilities</p><h1>Eyes across the spectrum.</h1><p class="lede">Our science is built on observations. Alongside public archives, members of our group participate in or collaborate with multiple instruments spanning X-ray and optical wavelengths, giving us complementary views of the changing Universe.</p></div></section>
  {(['X-ray','Optical'] as const).map((wave)=><section class="section facility-section"><div class="section-inner"><header class="wave-heading"><p class="eyebrow">{wave} light</p><h2>{wave === 'X-ray' ? 'The hot and extreme Universe' : 'The changing and flickering Universe'}</h2></header>
    <div>{facilities.filter(f=>f.data.wavelength===wave).map((facility)=><article class="facility-row"><div class="facility-image"><img src={withBase(facility.data.image)} alt={facility.data.imageAlt} loading="lazy" /><p class="credit">{facility.data.imageCredit}</p></div><div class="facility-copy"><p class="eyebrow">{facility.data.status}</p><h3>{facility.data.name}</h3><p>{facility.data.summary}</p><div class="how"><strong>How we use it</strong><p>{facility.data.usage}</p></div><div class="facility-links"><ArrowLink href={facility.data.officialUrl} label={`${facility.data.shortName} official site`} external />{facility.data.relatedPapers.length > 0 && <div class="related-papers"><p class="eyebrow">Related group papers</p>{facility.data.relatedPapers.map((paper)=><a href={paper.url} target="_blank" rel="noreferrer"><strong>{paper.title}</strong><span>{paper.citation}</span><span aria-hidden="true">↗</span></a>)}</div>}</div></div></article>)}</div>
  </div></section>)}
</BaseLayout>
<style>
.facility-section:nth-of-type(odd){background:var(--paper)}.wave-heading{max-width:820px;margin-bottom:3rem}.wave-heading h2{margin:0}.facility-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,1fr);gap:clamp(2rem,5vw,5rem);padding:clamp(2.2rem,4vw,4rem) 0;border-top:1px solid var(--line)}.facility-image img{width:100%;height:clamp(300px,32vw,420px);object-fit:cover;background:#ddd}.facility-copy{align-self:center}.facility-copy h3{font-size:clamp(1.9rem,3.2vw,3.4rem);margin-bottom:1.2rem}.facility-copy>p:not(.eyebrow){font-size:1.03rem}.how{border-left:3px solid var(--red);padding-left:1rem;margin:1.5rem 0}.how strong{font:600 .72rem var(--mono);text-transform:uppercase;letter-spacing:.06em}.how p{margin:.4rem 0 0}.facility-links>.arrow-link{margin-bottom:1.6rem}.related-papers{border-top:1px solid var(--line);padding-top:1.2rem}.related-papers>a{display:grid;grid-template-columns:1fr auto;gap:.2rem 1rem;text-decoration:none}.related-papers>a strong{font:600 .9rem/1.35 var(--display)}.related-papers>a span:first-of-type{font:400 .68rem/1.4 var(--mono);color:var(--carbon-60)}.related-papers>a span:last-child{grid-column:2;grid-row:1/3;color:var(--red);align-self:center}@media(max-width:800px){.facility-row{grid-template-columns:1fr}.facility-image img{height:min(68vw,400px)}}
</style>
