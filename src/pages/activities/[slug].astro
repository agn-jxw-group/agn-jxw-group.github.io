---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../config/site';
export async function getStaticPaths(){return (await getCollection('activities')).map((activity)=>({params:{slug:activity.id},props:{activity}}));}
const {activity}=Astro.props; const {Content}=await render(activity);
---
<BaseLayout title={activity.data.title} description={activity.data.summary} image={activity.data.cover}>
  <section class="activity-title"><div><p class="eyebrow">Group activity · {activity.data.date.toLocaleDateString('en',{month:'long',year:'numeric'})}</p><h1>{activity.data.title}</h1><p>{activity.data.summary}</p></div></section>
  <section class="gallery section"><div class="section-inner">{activity.data.gallery.map((image,index)=><figure><button class="gallery-open" type="button" data-dialog={`photo-${index}`} aria-label={`View larger: ${image.alt}`}><img src={withBase(image.src)} alt={image.alt} /></button><figcaption>{image.credit}</figcaption><dialog id={`photo-${index}`}><button class="gallery-close" type="button" aria-label="Close image">×</button><img src={withBase(image.src)} alt={image.alt} /><p>{image.credit}</p></dialog></figure>)}</div></section>
  <section class="section"><div class="prose"><Content /></div></section>
</BaseLayout>
<script>
document.querySelectorAll<HTMLButtonElement>('.gallery-open').forEach((button)=>button.addEventListener('click',()=>document.querySelector<HTMLDialogElement>(`#${button.dataset.dialog}`)?.showModal()));
document.querySelectorAll<HTMLDialogElement>('dialog').forEach((dialog)=>{dialog.querySelector<HTMLButtonElement>('.gallery-close')?.addEventListener('click',()=>dialog.close());dialog.addEventListener('click',(event)=>{if(event.target===dialog)dialog.close();});});
</script>
<style>.activity-title{padding:clamp(5rem,10vw,10rem) var(--pad)}.activity-title>div{max-width:var(--max);margin:auto}.activity-title h1{margin-bottom:2rem}.activity-title>div>p:last-child{font-size:1.25rem;max-width:700px}.gallery{background:#000}.gallery figure{margin:0}.gallery-open{border:0;background:transparent;padding:0;cursor:zoom-in;width:100%}.gallery-open img{width:100%;max-height:82vh;object-fit:contain}.gallery figcaption{color:#aaa;font:400 .68rem var(--mono);padding-top:.8rem}.gallery dialog{border:0;background:#000;color:#fff;padding:3rem;max-width:95vw;max-height:95vh}.gallery dialog::backdrop{background:#000d}.gallery dialog img{max-width:88vw;max-height:78vh}.gallery dialog p{font:400 .68rem var(--mono);color:#bbb}.gallery-close{position:absolute;right:.6rem;top:.3rem;color:#fff;background:transparent;border:0;font-size:2rem;cursor:pointer}</style>
