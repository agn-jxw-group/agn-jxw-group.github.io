---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getPublishedNews } from '../../lib/news';

const { entries } = await getPublishedNews();
---
<BaseLayout title="News" description="The latest research, people, and activities from USTC Active Universe.">
  <section class="page-hero"><div><p class="eyebrow">Latest from the group</p><h1>News</h1><p class="lede">Research results, new faces, shared moments, and other updates from our group.</p></div></section>
  <section class="section news-archive"><div class="section-inner">
    <div class="news-grid">{entries.map((entry) => <NewsCard entry={entry} size="archive" />)}</div>
  </div></section>
</BaseLayout>

<style>
  .news-archive{background:#fff}.news-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(2rem,4vw,4rem) clamp(1rem,2vw,1.8rem)}
  @media(max-width:900px){.news-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:600px){.news-grid{grid-template-columns:1fr}}
</style>
